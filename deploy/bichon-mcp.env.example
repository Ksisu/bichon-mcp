# /etc/bichon-mcp.env  (root:root, mode 600)

# Bichon as reachable from this server (e.g. over a VPN)
BICHON_URL=http://bichon.lan:15630
# API token of a READ-ONLY Bichon user (global role "member" + account role "account_viewer"
# on each account to expose). Create it in Bichon → Settings → API tokens while logged in as that user.
BICHON_TOKEN=
# Time zone for dates in tool input and output (default: the server's, which is often UTC)
BICHON_TZ=Europe/Berlin

# What you paste into Claude → Settings → Connectors (DNS must point at this server)
MCP_PUBLIC_URL=https://mail-mcp.example.com/mcp
# Asked once when you connect. Generate: openssl rand -base64 24
MCP_LOGIN_PASSWORD=

# Networks besides Anthropic that may call the API directly (space-separated CIDRs, e.g. your
# VPN subnets). Used by install.sh for the Caddy site; leave empty to allow only Anthropic.
MCP_ALLOWED_SUBNETS="10.8.0.0/24"
